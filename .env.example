# J.A.R.V.I.S. Environment Variables Template
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

GITHUB_PERSONAL_ACCESS_TOKEN=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

GROQ_API_KEY=

# Comma-separated MCP servers whose native tool schemas are exposed to the LLM
# (default: puppeteer — enables deep click/type/scroll browser-agent control).
JARVIS_MCP_NATIVE_SERVERS=puppeteer

# Human cognition researcher (E.D.I.T.H.) cycle interval in seconds (default 1200)
JARVIS_HUMAN_RESEARCH_INTERVAL_S=1200

# ── Cloud lean-mode overrides (Render: 512MB RAM cap) ─────────────────────
# Hosts with RENDER/PORT set skip server-side Whisper STT and camera biometrics
# by default so the service fits under the free-tier memory cap. To force them
# back on (e.g. after upgrading the instance plan), set:
#JARVIS_WHISPER_MODEL=small
#JARVIS_ENABLE_BIOMETRICS=1

# ── Listener Intelligence (voice misrouting defence) ───────────────────────
# 1. Language gate  : drop non-English / undecidable speech before routing.
#    Languages Whisper may act on (default: just English):
#JARVIS_STT_LANGUAGES=en
#    Minimum Whisper language probability before a detection is trusted, and
#    worst-segment avg_logprob floor for speech confidence (defaults shown):
#JARVIS_STT_LANG_MIN_PROB=0.6
#JARVIS_STT_MIN_LOGPROB=-1.0
# 2. Speaker gate   : once `python3 enroll_admin.py` has run, only the
#    enrolled admin's voice commands. 0 = permissive (default 1):
#JARVIS_SPEAKER_GATE=1
# 3. Fuzzy commands : repair mishearings at the routing choke point
#    ("open utoobe" -> youtube) and broadcast what was assumed. 0 = off:
#JARVIS_FUZZY_COMMANDS=1

# ── God's Eye View (vendored live OSINT globe in godseye/) ────────────────
# Local instances: enabled by default. The Node/Vite sidecar spawns lazily on
# first use (HUD "GOD'S EYE [O]" button, hotkey O, voice phrase, or the
# open_board LLM tool) on 127.0.0.1:4174. First use runs `npm ci` once.
# Render/cloud instances: disabled by default (a Node process would fight the
# 512MB memory cap). Set 1/0 to force either way. Needs Node 24.x or 26.x.
#JARVIS_GODSEYE=1
# Custom sidecar port (also settable as "godseye.port" in jarvis.json):
#JARVIS_GODSEYE_PORT=4174
# No AI keys are needed for the globe itself: geographic search uses keyless
# Nominatim and "nearest X" uses keyless Overpass. GOOGLE_MAPS_API_KEY (set in
# godseye/.env, not here) only upgrades imagery (photoreal 3D tiles, Street
# View) and place-search quality. The globe owns no brain — JARVIS feeds it
# actions through the command bridge, and speaks every answer itself.

# ── Google Workspace (Calendar + Gmail voice bridge) ───────────────────────
# One-time setup: create OAuth Desktop credentials in the cloud console,
# download them as credentials.json NEXT TO jarvis.py (project
# jarvis-assistant-508807), then start JARVIS once and complete the browser
# consent. The token is cached separately as .google-workspace-token.json.
# Reads are read-only; event creation requests calendar.events (default
# on — set 0 to keep every write off the consent screen). A cached token
# missing an enabled scope re-runs the browser consent automatically.
# JARVIS_GOOGLE_ALLOW_MARK_READ=1 additionally requests gmail.modify so
# the watcher can mark notified mail as read.
#JARVIS_GOOGLE_BRIDGE_ENABLED=1
#JARVIS_GOOGLE_ALLOW_WRITE=1
#JARVIS_GOOGLE_ALLOW_MARK_READ=0
# Poll intervals in seconds (calendar is faster: a missed meeting costs more):
#JARVIS_GOOGLE_CALENDAR_POLL_S=300
#JARVIS_GOOGLE_GMAIL_POLL_S=600
# Scheduled morning briefing time (local, 24h; default 08:00):
#JARVIS_BRIEFING_HOUR=8
#JARVIS_BRIEFING_MINUTE=0
# Quiet hours (local hour of day; voice "quiet hours 22 to 8" overrides these
# and persists the values into memory/Profile.md):
#JARVIS_GOOGLE_QUIET_START_H=22
#JARVIS_GOOGLE_QUIET_END_H=8
# Watcher filters (comma-separated): urgent event titles that always notify,
# mail subject keywords/labels the digest cares about:
#JARVIS_GOOGLE_URGENT_KEYWORDS=
#JARVIS_GOOGLE_MAIL_KEYWORDS=
#JARVIS_GOOGLE_MAIL_LABELS=
# Headless/CI provisioning: paste the OAuth token JSON here instead of the
# browser flow (written to .google-workspace-token.json on first start):
#GOOGLE_WORKSPACE_TOKEN_JSON=

# OpenRouter free-model pool (https://openrouter.ai/keys) — get a key and put
# it in your local .env as OPENROUTER_API_KEY=sk-or-v1-... . Without it the
# pool idles and JARVIS falls back to Groq/Ollama. Brain engine order lives
# in jarvis.json -> brain.engine ("auto"/"openrouter"/"groq"/"ollama").
